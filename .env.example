APP_NAME="FridgeMama"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
CLIENT_PORT=5173

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# A file. No database server to bring up, and nothing to configure on the
# laptop that goes to the venue.
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# ── Fridge Scan ───────────────────────────────────────────────────────────
# The vision sidecar (vision/app.py) runs on this same laptop. Loopback only:
# the exhibition venue provides no internet, so detection must never need one.
# Start it with scripts/start-demo.ps1.
VISION_URL=http://127.0.0.1:8001
VISION_TIMEOUT=30
# Detection floor. Low on purpose — the cook confirms every chip before it
# reaches the fridge, so a few extra guesses cost one tap while a missed
# ingredient costs a retake.
VISION_CONFIDENCE=0.12

VITE_APP_NAME="${APP_NAME}"
