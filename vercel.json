{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd client && npm ci && VITE_PREVIEW=true npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "echo \"install happens in buildCommand, inside client/\"",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|preview-art/|manifest.webmanifest|sw.js|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
